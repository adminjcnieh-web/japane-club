# CONTOH saja. Tidak ada rahasia asli di file ini.
#
# Aplikasi ini memakai Cloudflare Worker, jadi rahasia TIDAK ditaruh di file .env di server.
# Rahasia diatur dengan perintah (lihat README bagian 4):
#   cd backend
#   npx wrangler secret put FIREBASE_SERVICE_ACCOUNT   (isi file service-account.json)
#   npx wrangler secret put QR_SECRET                  (string acak >= 32 karakter)
#
# Untuk pengembangan lokal, salin backend/.dev.vars.example menjadi backend/.dev.vars.
#
# Variabel TIDAK rahasia ada di backend/wrangler.toml:
#   FIREBASE_PROJECT_ID, FIREBASE_API_KEY, EMAIL_DOMAIN, TZ_OFFSET_MINUTES, ALLOWED_ORIGINS
#
# Untuk skrip scripts/*.mjs, berikan lokasi file kunci lewat --key=./service-account.json
# atau variabel berikut (opsional):
FIREBASE_SERVICE_ACCOUNT_FILE=./service-account.json
